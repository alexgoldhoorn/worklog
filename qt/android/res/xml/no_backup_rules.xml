<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to cloud backup or a device-to-device transfer (allowBackup="false" covers
     older versions); the saved login and the widget's cache are not meant to leave the device -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
