<?xml version="1.0" encoding="utf-8"?>
<!-- the timer widget (TimerWidget.java); updatePeriodMillis is the slowest refresh, the 30 minute minimum -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="100dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/timer_widget"
    android:previewLayout="@layout/timer_widget"
    android:description="@string/timer_widget_description" />
