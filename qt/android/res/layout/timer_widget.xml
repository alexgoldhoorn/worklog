<?xml version="1.0" encoding="utf-8"?>
<!-- the timer widget (TimerWidget.java): state and elapsed time, the project, and the actions.
     Only views RemoteViews supports. Tapping the text opens the app; the icon refreshes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/widget_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stopped"
                android:textColor="#aeb7c4"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <Chronometer
                android:id="@+id/widget_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#e7eaef"
                android:textSize="20sp"
                android:fontFeatureSettings="tnum"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:src="@drawable/ic_timer"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_project"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#98a2b3"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_start"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#15803d"
            android:textColor="#ffffff"
            android:text="Start" />

        <Button
            android:id="@+id/widget_pause"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#b45309"
            android:textColor="#ffffff"
            android:text="Pause"
            android:visibility="gone" />

        <Button
            android:id="@+id/widget_stop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#4b5563"
            android:textColor="#ffffff"
            android:text="Stop"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
